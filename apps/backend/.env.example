APP_ENV=development
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

POSTGRES_DSN=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_RATE_LIMIT=10

AUTH_API_KEYS=your-api-key-here

RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

LOG_LEVEL=info
METRICS_ENABLED=true
